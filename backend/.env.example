# Copy to .env for local runs. Never commit .env.

# Supabase project (Settings -> Data API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Settings -> API -> service_role (server-side only; never sent to the browser)
SUPABASE_SERVICE_KEY=your-service-role-key

# Google AI Studio free-tier key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Optional: Render sets PORT automatically
PORT=10000
